# -------------------------------------------------------------
# Configuración de Base de Datos (PostgreSQL)
# -------------------------------------------------------------
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/porthos_db?schema=public"

# -------------------------------------------------------------
# Autenticación (NextAuth)
# -------------------------------------------------------------
# En producción, usa una clave segura generada con `openssl rand -base64 32`
NEXTAUTH_SECRET="super_secret_key_porthos_dev_only"
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------------------------
# Servicio de Mensajería (WhatsApp / SMS)
# -------------------------------------------------------------
# Si usas Twilio o una API oficial de WhatsApp de Meta
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER=""

# -------------------------------------------------------------
# Servicio de Correos (Resend)
# -------------------------------------------------------------
# Con RESEND_API_KEY el composition root usa ResendEmailMessagingAdapter.
# Sin clave, cae a ConsoleMessagingAdapter (log en consola).
RESEND_API_KEY=""
EMAIL_FROM="Porthos <notificaciones@tu-dominio.com>"
# Vars SMTP reservadas para un adaptador futuro (no usadas aún):
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"

# -------------------------------------------------------------
# IA: Análisis Inteligente de Contratos (PDF)
# -------------------------------------------------------------
# Con OPENAI_API_KEY usa OpenAiPdfParserAdapter; sin clave, heurística local.
OPENAI_API_KEY=""

# -------------------------------------------------------------
# Almacenamiento de PDFs de contratos
# -------------------------------------------------------------
# Con BLOB_READ_WRITE_TOKEN → VercelBlobFileStorageAdapter.
# Sin token → LocalPublicFileStorageAdapter (public/contracts/).
# Crear store: Vercel Dashboard → Storage → Blob, o `vercel blob`.
BLOB_READ_WRITE_TOKEN=""

# Vars S3 reservadas (no cableadas aún):
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET_NAME=""
